      "description": "Switch between Day/Week/Month/Year views",
      "method": "keyboard",
      "steps": [
        "Cmd+1 = Day, Cmd+2 = Week, Cmd+3 = Month, Cmd+4 = Year",
        "Cmd+T = Go to Today, Shift+Cmd+T = Go to specific date"
      ]
    },
    "check_availability": {
